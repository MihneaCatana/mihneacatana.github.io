---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  index: number;
}

const { project, index } = Astro.props;
const { title, year, stack, image } = project.data;
---

<a class="work-row fade-up" href={`/work/${project.id}/`} data-preview={image} style={`--d:${(index % 3) + 1}`}>
  <span class="idx">{String(index + 1).padStart(2, '0')}</span>
  <span class="title">{title}</span>
  <span class="row-meta">
    <span class="meta-stack">{stack.slice(0, 2).join(' · ')}</span>
    <span>{year}</span>
    <span class="arrow" aria-hidden="true">→</span>
  </span>
</a>
