---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import ProjectRow from '../../components/ProjectRow.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Work — Mihnea Catana" description="Selected work by Mihnea Catana: AI agents, enterprise AI tooling, and IoT systems.">
  <section class="section container">
    <h1 class="h-display h2 reveal page-title">
      <span class="reveal-inner">Selected <em class="accent-word">work.</em></span>
    </h1>
    <p class="lede fade-up" style="--d: 1">
      A few things I've built that taught me something — from agent infrastructure to multi-tenant SaaS and IoT
      command centers. Each one opens into the full story: the problem, the approach, and what actually happened.
    </p>

    <div class="work-list">
      {projects.map((p, i) => <ProjectRow project={p} index={i} />)}
    </div>
  </section>
</BaseLayout>

<style>
  .page-title {
    margin-bottom: 1.6rem;
  }

  .section :global(.lede) {
    margin-bottom: clamp(2.5rem, 6vh, 4rem);
  }
</style>
